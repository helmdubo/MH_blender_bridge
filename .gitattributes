# Auto detect text files and perform LF normalization
* text=auto
golden/canonical_vectors.json text eol=lf
golden/fbxdump/*.json text eol=lf

# Bytes of these files ARE identity: they are hashed into goldens, receipts and
# protocol signatures, so git must never rewrite their line endings on any host.
reference/dagor_fixtures/** text eol=lf
golden/v5/** text eol=lf

# Frozen diagnostic evidence, not protocol assets; preserve receipt SHA256.
docs/reference_notes/evidence/dagor_inventory_20260828/** text eol=lf
docs/reference_notes/evidence/dag4blend_bridge_20260828/** text eol=lf
# Pytest tracebacks retain blank indentation and source-line spacing verbatim.
docs/reference_notes/evidence/dag4blend_bridge_20260828/*.xml whitespace=-blank-at-eol
